# ===== DATABASE =====
# Configuração do banco de dados MySQL
# Formato: mysql://usuario:senha@host:porta/nome_banco_dados
DATABASE_URL="mysql://root:password@localhost:3306/tarefas_db"

# ===== SERVER =====
# Porta do servidor Express (padrão: 3000)
PORT=3000

# ===== ENVIRONMENT =====
# Ambiente de execução: development ou production
NODE_ENV=development

# ===== CORS =====
# URL do frontend para CORS (padrão Vite: http://localhost:5173)
FRONTEND_URL=http://localhost:5173
